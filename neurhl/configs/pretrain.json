{
  "_comment": "NeurHL event-LM pretraining config. Locked at prereg commit; changes after lock void the run (P7 search budget applies).",
  "d_model": 192,
  "n_layers": 4,
  "n_heads": 6,
  "d_player_embed": 64,
  "dropout": 0.2,
  "context_len": 512,
  "batch_size": 64,
  "optimizer": "adamw",
  "lr": 3e-4,
  "lr_schedule": "cosine",
  "warmup_steps": 1000,
  "weight_decay": 0.1,
  "epochs_max": 30,
  "early_stop": "held-in-window latest season, patience 3",
  "mask_ratio": 0.20,
  "objectives": ["masked_event", "next_event"],
  "targets": ["event_type", "actor_among_dressed", "coord_bucket", "dt_bucket"],
  "augmentation": {"coord_jitter_ft": 3, "x_flip": true, "sequence_crop": true},
  "seed_base": 20140,
  "device_train": "mps",
  "device_inference": "cpu"
}
